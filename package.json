{
  "name": "open-accessibility-widget",
  "version": "1.3.1",
  "description": "Framework-agnostic accessibility preferences widget for any website: plain JS, React, Next.js, Vue, Angular, Svelte. Profiles, text/color/navigation adjustments, themable, RTL-ready, TypeScript types included.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/open-accessibility-widget.global.js",
  "jsdelivr": "./dist/open-accessibility-widget.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./languages": {
      "import": {
        "types": "./dist/languages.d.ts",
        "default": "./dist/languages.js"
      },
      "require": {
        "types": "./dist/languages.d.cts",
        "default": "./dist/languages.cjs"
      }
    },
    "./global": "./dist/open-accessibility-widget.global.js",
    "./global/languages": "./dist/open-accessibility-widget.languages.global.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "workspaces": [
    "examples"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.mjs\"",
    "size": "node scripts/check-size.mjs",
    "check": "npm run typecheck && npm run build && npm run size && npm test",
    "prepublishOnly": "npm run check",
    "dev": "npm run dev -w examples",
    "site": "npm run build -w examples",
    "banner": "node scripts/render-banner.mjs"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "widget",
    "react",
    "vue",
    "angular",
    "svelte",
    "vanilla-js",
    "user-preferences",
    "text-size",
    "contrast",
    "rtl"
  ],
  "author": "alhassan-ahmed",
  "homepage": "https://open-accessibility-widget.vercel.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alhassan73/open-accessibility-widget.git"
  },
  "bugs": {
    "url": "https://github.com/alhassan73/open-accessibility-widget/issues"
  },
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "axe-core": "^4.14.0",
    "react": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
